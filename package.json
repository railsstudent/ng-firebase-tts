{
  "name": "ng-firebase-tts",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node firebase/scripts/prebuild.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.{ts,js,html}\" \"*.{mjs,json}\"",
    "preview": "npm run build && npx serve dist/ng-firebase-tts/browser -p 5005",
    "preview:emulator": "npm run build && npx serve dist/ng-firebase-tts/browser --listen $PORT",
    "firebase:emulate": "cd firebase; firebase emulators:start --project default",
    "config:fetch": "node firebase/scripts/get-firebase-remote-config.js",
    "config:generate": "node firebase/scripts/generate-firebase-config.js"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "22.1.4",
    "firebase": "12.18.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-unicorn": "73.0.0",
    "husky": "9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "17.3.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.1.11"
  }
}
